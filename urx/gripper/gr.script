  rg_status_error_s2_pushed_secondary="Der Sicherheitsschalter S2 am sekundären RG wurde gedrückt."
  rg_status_error_s2_triggered_secondary="Der Sicherheitsschalter S2 am sekundären RG wurde ausgelöst.<br>Bitte starten Sie den RG-Greifer neu."
