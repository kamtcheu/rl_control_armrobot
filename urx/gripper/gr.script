  def ft_dataProcess_errors_hex(sensor_stop=False):
  if(ft_Status_hex!=0):
  local sensor_status_bits=integer_to_binary_list(ft_Status_hex)
  sensor_stop=on_error(sensor_status_bits[0],hex_sensor_bit0_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error(sensor_status_bits[1],hex_sensor_bit1_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error(sensor_status_bits[2],hex_sensor_bit2_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error(sensor_status_bits[3],hex_sensor_bit3_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error(sensor_status_bits[4],hex_sensor_bit4_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error(sensor_status_bits[5],hex_sensor_bit5_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error(sensor_status_bits[6],hex_sensor_bit6_error,hex_sensor_error_title,sensor_stop)
  on_warning(sensor_status_bits[7],hex_sensor_bit7_warning,hex_sensor_warning_title)
  sensor_stop=on_error(sensor_status_bits[8],hex_sensor_bit8_error,hex_sensor_error_title,sensor_stop)
  sensor_stop=on_error((ft_Status_hex>511),hex_sensor_else_error,hex_sensor_error_title,sensor_stop)
  textmsg(hex_sensor_status_msg,ft_Status_hex)
  end
  return sensor_stop
  end
  thread ft_dataProcess_hex_thread():
  if ON_DEBUG_LOG:
  textmsg("Starting dataProcess thread")
  end
  while ft_dataProcess_running:
  sync()
  local sensor_stop=False
  if(ft_Sensor_ID==FT_SENSOR_ID_HEX_V1 or ft_Sensor_ID==FT_SENSOR_ID_HEX_V2 or ft_Sensor_ID==FT_SENSOR_ID_HEX_V3):
  on_hex=True
  elif(ft_Sensor_ID==FT_SENSOR_ID_RG2FT_V0 or ft_Sensor_ID==FT_SENSOR_ID_RG2FT_V1 or ft_Sensor_ID==FT_SENSOR_ID_RG2FT_V2):
  on_hex=False
  elif(ft_Sensor_ID==FT_SENSOR_ID_UNDEFINED):
  if(ft_has_valid_ID):
  textmsg("Sensor type ID: ",ft_Sensor_ID)
  popup(hex_sensor_bit1_error,title=hex_sensor_error_title,error=True,blocking=False)
  halt
  end
  if ON_DEBUG_LOG:
  textmsg("Establishing connection with the sensor.. Undefined sensor: ",ft_Sensor_ID)
  end
  else:
  textmsg("Sensor type ID: ",ft_Sensor_ID)
  popup(hex_sensor_error_type,title=hex_sensor_error_title,error=True,blocking=False)
  halt
  end
  sensor_stop=on_error(((True)xor(on_hex)),hex_sensor_error_mixed,hex_sensor_error_title,sensor_stop)
  sensor_stop=ft_dataProcess_errors_hex(sensor_stop)
  if sensor_stop:
  halt
  end

  local tcp_transform=on_robot_TCP_offset
  tcp_transform[0]=0
  tcp_transform[1]=0
  tcp_transform[2]=0
  tcp_transform=pose_inv(tcp_transform)
  local tcpF=pose_trans(tcp_transform,p[FT_hex[0],FT_hex[1],FT_hex[2],0,0,0])
  local tcpT=pose_trans(tcp_transform,p[FT_hex[3],FT_hex[4],FT_hex[5],0,0,0])
  Fx=tcpF[0]
  Fy=tcpF[1]
  Fz=tcpF[2]
  Tx=tcpT[0]
  Ty=tcpT[1]
  Tz=tcpT[2]
  F3D=norm([Fx,Fy,Fz])
  T3D=norm([Tx,Ty,Tz])
  local act_transform=get_actual_tool_flange_pose()
  act_transform[0]=0
  act_transform[1]=0
  act_transform[2]=0
  local bF=pose_trans(act_transform,p[FT_hex[0],FT_hex[1],FT_hex[2],0,0,0])
  local bT=pose_trans(act_transform,p[FT_hex[3],FT_hex[4],FT_hex[5],0,0,0])
  FT_Base=[bF[0],bF[1],bF[2],bT[0],bT[1],bT[2]]
  FT_Tool=[Fx,Fy,Fz,Tx,Ty,Tz]
  end
  if ON_DEBUG_LOG:
  textmsg("Stopping dataProcess thread")
  end
  end

  #======    End of OnRobot HEX Engine    ======#
